# MongoDB URI
# Use your MongoDB Atlas connection string or local MongoDB connection string.
MONGODB_URI=your-mongodb-uri

# Server Port
PORT=3000

# File Manager Online Storage
# The File Manager uses MongoDB GridFS. No Google Drive or Cloudinary account is needed.
# Video uploads are temporarily disabled to save storage.

# Session secret for production. Use a long random value in Render.
SESSION_SECRET=change-this-to-a-long-random-secret

# Render persistent disk settings. Only needed if you attach a disk.
# Recommended Render disk mount path: /var/data
RENDER_DISK_MOUNT_PATH=/var/data
UPLOADS_ROOT_DIR=/var/data/uploads
BACKUP_DIR=/var/data/backups
NODE_ENV=production
